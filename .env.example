VITE_API_BASE_URL=http://localhost:3000/api

# Dev-only fallback for window.celebrationId (see src/lib/celebrationId.ts)
# so local dev doesn't need a ?celebrationId= query param on every load.
# In production this comes from whatever embeds/serves the page instead.
VITE_CELEBRATION_ID=3fe69f43-ef7c-4aef-9ba1-0e68275e0d98

# Google Maps JavaScript API key used by the Events page (src/pages/EventsPage.tsx,
# src/lib/googleMaps.ts) to render the map and its event markers. Same key
# (and same Google Cloud project/APIs — Maps JavaScript API) as the admin
# backend's NEXT_PUBLIC_GOOGLE_MAPS_API_KEY, just under Vite's VITE_ prefix
# instead of Next's NEXT_PUBLIC_. Without it, the Events page shows a "map
# unavailable" message but the sidebar event list still works.
VITE_GOOGLE_MAPS_API_KEY=
